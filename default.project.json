{
  "name": "Rovloc",
  "globIgnorePaths": ["**/*.md", "**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "Workspace": {
      "$properties": {
        "Gravity": 196.2
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "ClockTime": 0.5,
        "Brightness": 0.5,
        "Ambient": [0.0941, 0.1059, 0.1373],
        "OutdoorAmbient": [0.1725, 0.1922, 0.2431],
        "EnvironmentDiffuseScale": 0.22,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.42,
        "ExposureCompensation": 0.3
      }
    },

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "Tests": {
        "$path": "tests"
      }
    },

    "MaterialService": {
      "RovlocTextures": {
        "$path": "src/MaterialService/RovlocTextures.model.json"
      }
    }
  }
}
