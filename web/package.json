{
  "name": "rovloc-web",
  "private": true,
  "version": "1.0.0",
  "description": "Rovloc for the browser: a static site (Max to Potato graphics, textures streamed per tier) and an offline single-file lite build",
  "type": "module",
  "scripts": {
    "export": "lune run tools/export-world.luau",
    "textures": "python3 tools/textures.py",
    "bake": "node tools/bake.mjs",
    "data": "npm run export && npm run textures && npm run bake",
    "presets": "lune run tools/export-presets.luau",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs && node tools/check.mjs",
    "parity": "node tools/tier-parity.mjs",
    "sounds": "nice -n 10 node sounds/render.mjs",
    "sounds:test": "nice -n 10 node sounds/test.mjs",
    "sounds:audit": "nice -n 10 node sounds/audit.mjs",
    "sounds:format": "nice -n 10 node sounds/format-check.mjs",
    "sounds:board": "nice -n 10 node sounds/board.mjs",
    "sounds:import": "node sounds/import.mjs",
    "sounds:probe": "nice -n 10 node sounds/probe.mjs"
  },
  "dependencies": {
    "@supabase/realtime-js": "2.117.3",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@fontsource/patrick-hand": "5.3.0",
    "esbuild": "0.28.2",
    "ws": "8.22.0"
  }
}
